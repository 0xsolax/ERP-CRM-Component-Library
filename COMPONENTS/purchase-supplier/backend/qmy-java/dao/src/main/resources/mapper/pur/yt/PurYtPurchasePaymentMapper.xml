<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qiaomoyun.mapper.pur.yt.PurYtPurchasePaymentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.qiaomoyun.entity.pur.yt.PurYtPurchasePayment">
        <id column="id" property="id" />
        <result column="purchase_id" property="purchaseId" />
        <result column="amount" property="amount" />
        <result column="currency" property="currency" />
        <result column="create_user" property="createUser" />
        <result column="create_time" property="createTime" />
        <result column="update_user" property="updateUser" />
        <result column="update_time" property="updateTime" />
        <result column="tenant_id" property="tenantId" />
        <result column="is_deleted" property="isDeleted" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, purchase_id, amount,currency, create_user, create_time, update_user, update_time, tenant_id, is_deleted
    </sql>

    <!-- 根据条件查询采购单付款列表 -->
    <select id="list" resultType="com.qiaomoyun.entity.pur.yt.PurYtPurchasePayment" parameterType="com.qiaomoyun.param.fin.yt.FinYtPaymentQueryParams">
        SELECT
            pypp.*,
            (select nick_name from sys_user where user_id = pypp.create_user) as createUserName
        FROM pur_yt_purchase_payment as pypp
        WHERE is_deleted = 0
        <if test="purchaseId != null">
            AND purchase_id = #{purchaseId}
        </if>
        <if test="startTime != null">
            AND pypp.create_time >= #{startTime}
        </if>
        <if test="endTime != null">
            AND #{endTime} >=  pypp.create_time
        </if>
    </select>

    <select id="getTotalPaymentByPurchaseId" resultType="java.math.BigDecimal" parameterType="java.lang.Long">
        SELECT COALESCE(SUM(amount), 0)
        FROM pur_yt_purchase_payment
        WHERE purchase_id = #{purchaseId} AND is_deleted = 0
    </select>

</mapper>
